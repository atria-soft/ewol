<PopUp color="#000000A0" min-size="100,100%" expand="true" fill="true">
	<Box color="#404040FF" border-radius="8px" border-color="#606060FF" border-width="2px" padding="0px" margin="10%" min-size="80,80%" max-size="80,80%" expand="false" fill="false">
		<Sizer mode="VERTICAL" lock="true" fill="true" expand="true">
			<!-- Title bar -->
			<Box color="#505050FF" border-radius="8,8,0,0px" padding="8px" expand="true,false" fill="true,false">
				<Label name="[{ID}]file-chooser:title-label" expand="true,false" fill="true,false">_T{Title}</Label>
			</Box>

			<!-- Content area -->
			<Box color="#353535FF" padding="10px" expand="true" fill="true">
				<Sizer mode="VERTICAL" expand="true" fill="true">
					<!-- Folder path entry -->
					<Sizer mode="HORIZONTAL" expand="true,false" fill="true,false">
						<Image name="[{ID}]file-chooser:img-folder" src="THEME:Folder.svg?lib=ewol" expand="false" image-size="32,32px"/>
						<Spacer min-size="5,0px"/>
						<Entry name="[{ID}]file-chooser:entry-folder" expand="true,false" fill="true,false"/>
						<Spacer min-size="5,0px"/>
						<Image name="[{ID}]file-chooser:img-home" src="THEME:Home.svg?lib=ewol" expand="false" image-size="32,32px"/>
					</Sizer>

					<Spacer min-size="0,5px"/>

					<!-- File name entry -->
					<Sizer mode="HORIZONTAL" expand="true,false" fill="true,false">
						<Image name="[{ID}]file-chooser:img-file" src="THEME:File.svg?lib=ewol" expand="false" image-size="32,32px"/>
						<Spacer min-size="5,0px"/>
						<Entry name="[{ID}]file-chooser:entry-file" expand="true,false" fill="true,false"/>
						<Spacer min-size="37,0px"/>
					</Sizer>

					<Spacer min-size="0,10px"/>

					<!-- File browser area -->
					<SplitPane name="[{ID}]file-chooser:split-pane"
					           orientation="HORIZONTAL"
					           split-position="0.25"
					           separator-size="6"
					           min-first-size="100"
					           min-second-size="150"
					           expand="true"
					           fill="true">
						<ListFileSystem name="[{ID}]file-chooser:list-folder"
						                expand="true"
						                fill="true"
						                show-hidden="false"
						                show-file="false"
						                show-folder="true"/>
						<ListFileSystem name="[{ID}]file-chooser:list-files"
						                expand="true"
						                fill="true"
						                show-hidden="false"
						                show-file="true"
						                show-folder="false"/>
					</SplitPane>
				</Sizer>
			</Box>

			<!-- Footer with buttons -->
			<Box color="#454545FF" border-radius="0,0,8,8px" padding="8px" expand="true,false" fill="true,false">
				<Sizer mode="HORIZONTAL" expand="true,false" fill="true,false">
					<CheckBox name="[{ID}]file-chooser:show-hiden-file" label="_T{ShowHiddenFiles}"/>
					<Spacer expand="true,false"/>
					<Button name="[{ID}]file-chooser:button-validate">
						<Sizer mode="HORIZONTAL">
							<Image src="THEME:Load.svg?lib=ewol" fill="true" image-size="24,24px"/>
							<Spacer min-size="5,0px"/>
							<Label name="[{ID}]file-chooser:validate-label">_T{Validate}</Label>
						</Sizer>
					</Button>
					<Spacer min-size="10,0px"/>
					<Button name="[{ID}]file-chooser:button-cancel">
						<Sizer mode="HORIZONTAL">
							<Image src="THEME:Remove.svg?lib=ewol" fill="true" image-size="24,24px"/>
							<Spacer min-size="5,0px"/>
							<Label name="[{ID}]file-chooser:cancel-label">_T{Cancel}</Label>
						</Sizer>
					</Button>
				</Sizer>
			</Box>
		</Sizer>
	</Box>
</PopUp>
