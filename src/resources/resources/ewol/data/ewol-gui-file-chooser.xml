<PopUp color="#000000A0" min-size="100,100%" expand="true" fill="true">
	<Box color="#00000000" padding="0px" margin="0px" min-size="80,80%" max-size="80,80%" expand="false" fill="false">
		<Sizer mode="VERTICAL" lock="true" fill="true" expand="true">
			<!-- Title bar -->
			<Box color="#B0B0B0FF" border-radius="8,8,0,0px" padding="10px" expand="true,false" fill="true,false">
				<Label name="[{ID}]file-chooser:title-label" expand="true,false" fill="true,false">_T{Title}</Label>
			</Box>

			<!-- Content area -->
			<Box color="#353535FF" border-color="#B0B0B0FF" border-width="0,2,0,2px" padding="10px" expand="true" fill="true">
				<Sizer mode="VERTICAL" expand="true" fill="true">
					<!-- Folder path entry -->
					<Sizer mode="HORIZONTAL" expand="true,false" fill="true,false">
						<Icon name="[{ID}]file-chooser:icon-folder" icon="folder" expand="false" icon-size="32,32px" fill-color="#FFFFFFFF"/>
						<Spacer min-size="5,0px"/>
						<Entry name="[{ID}]file-chooser:entry-folder" expand="true,false" fill="true,false"/>
						<Spacer min-size="5,0px"/>
						<Icon name="[{ID}]file-chooser:icon-home" icon="home" expand="false" icon-size="32,32px" fill-color="#FFFFFFFF"/>
					</Sizer>

					<Spacer min-size="0,5px"/>

					<!-- File name entry -->
					<Sizer mode="HORIZONTAL" expand="true,false" fill="true,false">
						<Icon name="[{ID}]file-chooser:icon-file" icon="file" expand="false" icon-size="32,32px" fill-color="#FFFFFFFF" background-color="#808080FF"/>
						<Spacer min-size="5,0px"/>
						<Entry name="[{ID}]file-chooser:entry-file" expand="true,false" fill="true,false"/>
						<Spacer min-size="37,0px"/>
					</Sizer>

					<Spacer min-size="0,10px"/>

					<!-- File browser area -->
					<SplitPane name="[{ID}]file-chooser:split-pane"
					           orientation="HORIZONTAL"
					           split-position="0.25"
					           separator-size="6"
					           min-first-size="100"
					           min-second-size="150"
					           expand="true"
					           fill="true">
						<ListFileSystem name="[{ID}]file-chooser:list-folder"
						                expand="true"
						                fill="true"
						                show-hidden="false"
						                show-file="false"
						                show-folder="true"/>
						<ListFileSystem name="[{ID}]file-chooser:list-files"
						                expand="true"
						                fill="true"
						                show-hidden="false"
						                show-file="true"
						                show-folder="false"/>
					</SplitPane>
				</Sizer>
			</Box>

			<!-- Footer -->
			<Box color="#B0B0B0FF" border-radius="0,0,8,8px" padding="8px" expand="true,false" fill="true,false">
				<Sizer mode="HORIZONTAL" expand="true,false" fill="true,false">
					<CheckBox name="[{ID}]file-chooser:show-hiden-file" label="_T{ShowHiddenFiles}"/>
					<Spacer expand="true,false"/>
					<Button name="[{ID}]file-chooser:button-validate">
						<Sizer mode="HORIZONTAL">
							<Icon icon="open-in-app" fill-color="#80FF80FF" background-color="#408040FF" icon-size="24,24px"/>
							<Spacer min-size="5,0px"/>
							<Label name="[{ID}]file-chooser:validate-label">_T{Validate}</Label>
						</Sizer>
					</Button>
					<Spacer min-size="10,0px"/>
					<Button name="[{ID}]file-chooser:button-cancel">
						<Sizer mode="HORIZONTAL">
							<Icon icon="cancel" fill-color="#FF8080FF" icon-size="24,24px"/>
							<Spacer min-size="5,0px"/>
							<Label name="[{ID}]file-chooser:cancel-label">_T{Cancel}</Label>
						</Sizer>
					</Button>
				</Sizer>
			</Box>
		</Sizer>
	</Box>
</PopUp>
