							"widget-type":"ListFileSystem",
							"name":"[{ID}]file-shooser:list-files",
			                "min-size":"20,0%",
			                "expand":"true,true",
			                "show-hidden":false,
			                "show-file":true,
			                "show-folder":false,
			                "show-temporary":false
						}, {
							"widget-type":"spacer",
							"expand": "true,false" 
						}
					]
				}, {
					"widget-type":"sizer",
					"mode": "hori",
					"child": [
						{
							"widget-type":"image",
							"name": "[{ID}]file-shooser:img-file",
							"expand": false,
							"size": "8,8mm",
							"src": "THEME_GUI:///File.svg?lib:ewol"
						},
						{
							"widget-type":"entry",
							"name": "[{ID}]file-shooser:entry-file",
							"expand": "true,false",
